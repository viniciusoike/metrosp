Package: metrosp
Type: Package
Title: São Paulo Metro Passenger Demand Data
Version: 2.0.0
Authors@R: c(
    person(
      "Vinicius", "Oike",
      email = "viniciusoike@gmail.com",
      role = c("aut", "cre", "cph"),
      comment = c(ORCID = "0009-0005-8015-9189")
    )
